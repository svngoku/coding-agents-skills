#!/usr/bin/env bash
# Reference solution for the bootstrap-ledger-api task.
#
# skillgrade --validate runs this script inside a scratch workspace and then grades the result,
# so it must create ./ledger-api exactly as the instruction asks: run the skill's scaffold, then
# do the judgement work (tooling, AGENTS.md tailoring, handoff).
set -euo pipefail

SKILL_DIR="${HARNESS_REPO_SKILL_DIR:-}"
if [ -z "$SKILL_DIR" ]; then
  for candidate in .agents/skills/harness-repo .claude/skills/harness-repo; do
    [ -f "$candidate/scripts/scaffold.sh" ] && { SKILL_DIR="$candidate"; break; }
  done
fi
[ -f "$SKILL_DIR/scripts/scaffold.sh" ] || { echo "harness-repo skill not found" >&2; exit 1; }

bash "$SKILL_DIR/scripts/scaffold.sh" --name ledger-api --stack python \
  --desc "Double-entry ledger HTTP API for internal finance tools." --path .

cd ledger-api
mkdir -p ledger_api tests

cat > pyproject.toml <<'EOF'
[project]
name = "ledger-api"
version = "0.1.0"
description = "Double-entry ledger HTTP API for internal finance tools."
requires-python = ">=3.12"
dependencies = []

[dependency-groups]
dev = ["mypy", "pytest", "ruff"]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["ledger_api"]

[tool.ruff]
line-length = 100

[tool.mypy]
strict = true

[tool.pytest.ini_options]
testpaths = ["tests"]
EOF

cat > ledger_api/__init__.py <<'EOF'
"""Double-entry ledger HTTP API for internal finance tools."""

__version__ = "0.1.0"
EOF

cat > ledger_api/__main__.py <<'EOF'
from ledger_api import __version__


def main() -> None:
    # TODO: start the HTTP server once the framework is chosen (see docs/design-docs/).
    print(f"ledger-api {__version__}")


if __name__ == "__main__":
    main()
EOF

cat > tests/test_smoke.py <<'EOF'
import ledger_api


def test_package_exposes_a_version() -> None:
    assert ledger_api.__version__
EOF

python3 - <<'EOF'
from pathlib import Path

path = Path("AGENTS.md")
text = path.read_text()
always = "- Draw every diagram in Mermaid (a `mermaid` code fence or `.mmd` file).\n"
never = "- Draw diagrams as ASCII art, PlantUML, or Graphviz.\n"
assert always in text and never in text
text = text.replace(
    always, always + "- Represent money as integer minor units (for example cents) with an explicit currency code.\n"
)
text = text.replace(never, never + "- Store or compute money as a float; amounts are integer minor units only.\n")
path.write_text(text)
EOF

cat > handoff.md <<'EOF'
# Handoff: ledger-api bootstrap

## Created

- `AGENTS.md` map (tailored for a double-entry ledger API) and the `CLAUDE.md` pointer.
- `docs/` knowledge base, design-docs, product-specs, and an active initial exec-plan.
- Security baseline files, hardened `ci.yml`, dependabot config, and the golden-principles linter.
- `pyproject.toml`, the `ledger_api` package, and one smoke test.

## Still needs a repository admin

These settings live on the hosting platform and were not changed by this bootstrap:

- [ ] Turn on branch protection for `main` (required checks: Preflight, Golden Principles).
- [ ] Turn on secret scanning with push protection.
- [ ] Turn on Dependabot alerts and security updates.
- [ ] Turn on private vulnerability reporting.
- [ ] Replace the placeholder handles in `.github/CODEOWNERS`.

## Next steps

1. Run `uv sync`, then the full gate in `AGENTS.md`.
2. Fill `docs/ARCHITECTURE.md` and the `TODO` items once the first feature is planned.
EOF
