# Install: pipx install pre-commit && pre-commit install
repos:
  - repo: https://github.com/gitleaks/gitleaks
    rev: v8.30.1
    hooks:
      - id: gitleaks
  - repo: local
    hooks:
      - id: golden-principles
        name: golden principles
        entry: {{GOLDEN}}
        language: system
        pass_filenames: false
