#!/usr/bin/env bash
# train.sh - fine-tune Qwen3-VL-8B (VLM) on HF Jobs with the Unsloth UV script.
# Replace <username> with your HF username, and <dataset> / <model-name> with
# your dataset and output repo. Requires HF CLI auth (HF_TOKEN secret).

set -euo pipefail

# 1) SMOKE TEST - run FIRST, before any full run. A --max-steps 10 run boots
#    the job, loads the dataset and validates the config in minutes for a few
#    cents; config errors (wrong data columns, missing secret, bad repo name)
#    otherwise burn GPU hours on a failing full run.
hf jobs uv run \
  https://huggingface.co/datasets/uv-scripts/unsloth-jobs/raw/main/sft-qwen3-vl.py \
  --flavor a100-large --secrets HF_TOKEN --timeout 4h \
  -- --dataset <username>/<dataset> \
     --output-repo <username>/<model-name> \
     --lora-r 16 --learning-rate 2e-4 \
     --batch-size 2 --gradient-accumulation 4 \
     --eval-split 0.1 \
     --max-steps 10

# 2) FULL TRAINING RUN - only after the smoke test passes. --merge-model
#    uploads the merged Qwen3-VL-8B model (not just the LoRA adapter) so the
#    output repo is directly deployable; --trackio-space streams live metrics
#    to a dashboard.
hf jobs uv run \
  https://huggingface.co/datasets/uv-scripts/unsloth-jobs/raw/main/sft-qwen3-vl.py \
  --flavor a100-large --secrets HF_TOKEN --timeout 4h \
  -- --dataset <username>/<dataset> \
     --output-repo <username>/<model-name> \
     --lora-r 16 --learning-rate 2e-4 \
     --batch-size 2 --gradient-accumulation 4 \
     --eval-split 0.1 \
     --merge-model \
     --trackio-space <username>/trackio \
     --num-epochs 1
