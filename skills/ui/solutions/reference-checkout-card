import { useState } from "react";
import { clsx, type ClassValue } from "clsx";
import { twMerge } from "tailwind-merge";
import { AlertDialog } from "@base-ui-components/react/alert-dialog";

export function cn(...inputs: ClassValue[]) {
  return twMerge(clsx(inputs));
}

export interface CartItem {
  id: string;
  name: string;
  price: number; // price in cents
}

const INITIAL_ITEMS: CartItem[] = [
  { id: "hoodie", name: "Merino hoodie", price: 8900 },
  { id: "cap", name: "Canvas cap", price: 2400 },
  { id: "socks", name: "Wool socks (3-pack)", price: 1900 },
];

function formatPrice(cents: number): string {
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
  }).format(cents / 100);
}

export function CheckoutCard() {
  const [items, setItems] = useState<CartItem[]>(INITIAL_ITEMS);
  const [cancelled, setCancelled] = useState(false);

  const subtotal = items.reduce((sum, item) => sum + item.price, 0);
  const total = subtotal;

  const removeItem = (id: string) =>
    setItems((prev) => prev.filter((item) => item.id !== id));

  const confirmCancel = () => {
    setCancelled(true);
    setItems([]);
  };

  if (cancelled) {
    return (
      <p className="text-balance text-sm text-zinc-600">
        Your order has been cancelled. Nothing was charged.
      </p>
    );
  }

  return (
    <section className="h-dvh flex items-center justify-center p-4">
      <div className="w-full max-w-sm rounded-lg border border-zinc-200 bg-white p-5 shadow-sm">
        <h2 className="text-balance text-lg font-semibold text-zinc-900">
          Order summary
        </h2>

        <ul className="mt-4 divide-y divide-zinc-100">
          {items.map((item) => (
            <li key={item.id} className="flex items-center gap-3 py-3">
              <span className="flex-1 truncate text-sm text-zinc-700">
                {item.name}
              </span>
              <span className="tabular-nums text-sm text-zinc-900">
                {formatPrice(item.price)}
              </span>
              <button
                type="button"
                aria-label={`Remove ${item.name}`}
                onClick={() => removeItem(item.id)}
                className="grid size-8 place-items-center rounded-full text-zinc-400 transition-colors hover:bg-zinc-100 hover:text-zinc-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-900"
              >
                <svg
                  aria-hidden="true"
                  viewBox="0 0 16 16"
                  className="size-4 fill-current"
                >
                  <path d="M4.3 4.3a1 1 0 0 1 1.4 0L8 6.6l2.3-2.3a1 1 0 1 1 1.4 1.4L9.4 8l2.3 2.3a1 1 0 0 1-1.4 1.4L8 9.4l-2.3 2.3a1 1 0 0 1-1.4-1.4L6.6 8 4.3 5.7a1 1 0 0 1 0-1.4Z" />
                </svg>
              </button>
            </li>
          ))}
        </ul>

        <dl className="mt-4 space-y-1 border-t border-zinc-100 pt-3 text-sm">
          <div className="flex justify-between">
            <dt className="text-zinc-500">Subtotal</dt>
            <dd className="tabular-nums text-zinc-700">
              {formatPrice(subtotal)}
            </dd>
          </div>
          <div className="flex justify-between">
            <dt className="text-zinc-500">Shipping</dt>
            <dd className="tabular-nums text-zinc-700">Free</dd>
          </div>
          <div className="flex justify-between font-semibold text-zinc-900">
            <dt>Total</dt>
            <dd className="tabular-nums">{formatPrice(total)}</dd>
          </div>
        </dl>

        <AlertDialog.Root>
          <AlertDialog.Trigger className="mt-5 w-full rounded-md bg-zinc-900 px-4 py-2 text-sm font-medium text-white hover:bg-zinc-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-900">
            Cancel order
          </AlertDialog.Trigger>
          <AlertDialog.Portal>
            <AlertDialog.Backdrop className="fixed inset-0 bg-black/40" />
            <AlertDialog.Popup className="fixed left-1/2 top-1/2 w-full max-w-sm -translate-x-1/2 -translate-y-1/2 rounded-lg bg-white p-5 shadow-lg">
              <AlertDialog.Title className="text-balance text-base font-semibold text-zinc-900">
                Cancel this order?
              </AlertDialog.Title>
              <AlertDialog.Description className="mt-2 text-sm text-zinc-600">
                Your cart will be emptied and the order will not be placed.
              </AlertDialog.Description>
              <div className="mt-5 flex justify-end gap-2">
                <AlertDialog.Close className="rounded-md px-3 py-1.5 text-sm text-zinc-600 hover:bg-zinc-100">
                  Keep order
                </AlertDialog.Close>
                <AlertDialog.Close
                  onClick={confirmCancel}
                  className="rounded-md bg-red-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-700"
                >
                  Cancel order
                </AlertDialog.Close>
              </div>
            </AlertDialog.Popup>
          </AlertDialog.Portal>
        </AlertDialog.Root>
      </div>
    </section>
  );
}
TSX

