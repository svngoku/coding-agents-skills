# Local skillgrade evaluation output (scripts/run-evals.sh)
.evals/

# Python artifacts (eval graders)
__pycache__/
*.pyc

# Gallery app (Vite)
site/node_modules/
site/dist/
site/.vite/
*.tsbuildinfo

